liq_min_height_atr = input.float(0.10, "Min Zone Height (x ATR)", group=grp_liq, minval=0.01, step=0.05, tooltip="Minimum zone height in ATR multiples. Prevents tiny noise zones.")
bsl_outline_col    = input.color(color.new(C_BSL, 0), "BSL Outline", group=grp_liq)
